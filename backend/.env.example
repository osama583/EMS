# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

FLASK_ENV=development
# Signs JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=https://pcqjxzvbzfyjptirazto.supabase.co
# Supabase dashboard -> Project Settings -> API -> service_role key.
# Server-side only. Bypasses row-level security; never ship it to the browser.
SUPABASE_SERVICE_KEY=

# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI.
# Use the SESSION POOLER URI (port 5432) so prepared statements work.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

DB_POOL_MIN=1
DB_POOL_MAX=10

# --- Auth -----------------------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
BCRYPT_ROUNDS=12

# --- CORS -----------------------------------------------------------------
# Comma-separated exact origins. No wildcard: credentials are sent cross-origin.
CORS_ORIGINS=http://localhost:4200

# --- Rate limiting --------------------------------------------------------
RATELIMIT_DEFAULT=300 per minute
RATELIMIT_AUTH=10 per minute
# Leave blank for in-process storage (dev only; per-worker, resets on restart).
RATELIMIT_STORAGE_URI=

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
# json for production/aggregation, console for local readability
LOG_FORMAT=console
