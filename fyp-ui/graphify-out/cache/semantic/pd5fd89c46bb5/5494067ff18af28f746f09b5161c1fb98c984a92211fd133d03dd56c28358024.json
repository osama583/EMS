{"nodes": [{"id": "docs_superpowers_specs_2026_08_10_ems_schema_alignment_and_mock_backend_design", "label": "EMS Schema Alignment + Mock Backend Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-10-ems-schema-alignment-and-mock-backend-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_10_ems_schema_alignment_and_mock_backend_design_backend_owns_workflow", "label": "Backend owns the workflow (design principle)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-10-ems-schema-alignment-and-mock-backend-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frontend sends actions and renders whatever state comes back; backend determines current step, authorization, next state, and history so the frontend is never trusted with authorization decisions."}, {"id": "docs_superpowers_specs_2026_08_10_ems_schema_alignment_and_mock_backend_design_fmb_role_merge", "label": "F&B role merge (FmbReviewer + FmbManager -> fmb)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-10-ems-schema-alignment-and-mock-backend-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The FmbReviewer/FmbManager split was a mistake representing one real job; merged into a single 'fmb' role owning high-pax review, F&B request review, and Mineral Water/Dietary dropdowns."}, {"id": "docs_superpowers_specs_2026_08_10_ems_schema_alignment_and_mock_backend_design_campus_tour_trim", "label": "Campus Tour trimmed to Starting Point only", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-10-ems-schema-alignment-and-mock-backend-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tour Area and Campus Map tables/columns/fields dropped entirely from both schema and frontend to simplify Campus Tour requests."}, {"id": "docs_superpowers_specs_2026_08_10_ems_schema_alignment_and_mock_backend_design_hoshod_self_review_skip", "label": "HOS/HOD self-review skip rule", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-10-ems-schema-alignment-and-mock-backend-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If the applicant is HOS/HOD of their own unit, hos_hod_review is skipped and F&B reviews next unconditionally; CFO still reviews after F&B if pax also exceeds HIGH_PAX_THRESHOLD."}, {"id": "docs_superpowers_specs_2026_08_10_ems_schema_alignment_and_mock_backend_design_water_merge_into_fmb", "label": "Mineral Water merged into F&B task", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-10-ems-schema-alignment-and-mock-backend-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mineral Water Logo/Normal is not a separate department lane; F&B reviews food and water together as one task, though option lookup tables remain separate."}, {"id": "docs_superpowers_specs_2026_08_10_ems_schema_alignment_and_mock_backend_design_workflow_state_machine", "label": "Corrected Workflow State Machine (section 3)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-10-ems-schema-alignment-and-mock-backend-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_10_ems_schema_alignment_and_mock_backend_design_workflow_service", "label": "workflow.service.js (state machine implementation)", "file_type": "code", "source_file": "docs/superpowers/specs/2026-08-10-ems-schema-alignment-and-mock-backend-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_10_ems_schema_alignment_and_mock_backend_design_department_review_parallel", "label": "department_review parallel independent tasks", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-10-ems-schema-alignment-and-mock-backend-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One request_task per selected requirement runs in parallel and independently; departments cannot reject outright, only resubmit-with-comment, so one department resubmitting doesn't affect others."}, {"id": "docs_superpowers_specs_2026_08_10_ems_schema_alignment_and_mock_backend_design_cafeteria_shared_inbox", "label": "Cafeteria Staff shared inbox mechanism", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-10-ems-schema-alignment-and-mock-backend-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "assignment_mode='shared_pool' means the first staff member to claim a fulfilment task owns it and it leaves everyone else's inbox, avoiding pre-assignment overhead."}, {"id": "docs_superpowers_specs_2026_08_10_ems_schema_alignment_and_mock_backend_design_mock_backend_server", "label": "Node/Express Mock Backend Server", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-10-ems-schema-alignment-and-mock-backend-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_10_ems_schema_alignment_and_mock_backend_design_db_js", "label": "server/db.js (aggregated seed db)", "file_type": "code", "source_file": "docs/superpowers/specs/2026-08-10-ems-schema-alignment-and-mock-backend-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_10_ems_schema_alignment_and_mock_backend_design_app_js", "label": "server/app.js (Express app)", "file_type": "code", "source_file": "docs/superpowers/specs/2026-08-10-ems-schema-alignment-and-mock-backend-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_10_ems_schema_alignment_and_mock_backend_design_index_js", "label": "server/index.js (http server bootstrap)", "file_type": "code", "source_file": "docs/superpowers/specs/2026-08-10-ems-schema-alignment-and-mock-backend-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_10_ems_schema_alignment_and_mock_backend_design_in_memory_only_rationale", "label": "In-memory only, no artificial latency", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-10-ems-schema-alignment-and-mock-backend-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server resets to seed state every restart with no disk writes and immediate reliable responses, async/Promise-shaped so swapping in-memory store for a real DB client is a drop-in change later."}], "edges": [{"source": "docs_superpowers_specs_2026_08_10_ems_schema_alignment_and_mock_backend_design", "target": "docs_system_logic_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-10-ems-schema-alignment-and-mock-backend-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_10_ems_schema_alignment_and_mock_backend_design", "target": "docs_system_logic_system_ems_database_schema_sql", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-10-ems-schema-alignment-an