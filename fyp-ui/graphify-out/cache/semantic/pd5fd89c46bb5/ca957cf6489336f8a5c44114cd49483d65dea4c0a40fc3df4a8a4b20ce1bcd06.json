{"nodes": [{"id": "docs_system_logic_rbac_unit_level_migration_prompt", "label": "Unit + Level RBAC Migration Prompt", "file_type": "document", "source_file": "docs/system-logic/rbac-unit-level-migration-prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_system_logic_rbac_unit_level_migration_prompt_unit_level_model", "label": "Unit + Level identity model", "file_type": "rationale", "source_file": "docs/system-logic/rbac-unit-level-migration-prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces flat per-department role strings with two independent fields, unit_code and function_level, so a person's unit and level can never contradict each other since they are no longer encoded in one field that can drift out of sync with a separate unit assignment."}, {"id": "docs_system_logic_rbac_unit_level_migration_prompt_applicant_role_deletion", "label": "applicant role deletion rationale", "file_type": "rationale", "source_file": "docs/system-logic/rbac-unit-level-migration-prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The applicant role is deleted entirely; every existing user with this role is migrated to student since applicants were conceptually always School-affiliated members submitting proposals."}, {"id": "docs_system_logic_rbac_unit_level_migration_prompt_generic_staff_deletion", "label": "generic staff role deletion rationale", "file_type": "rationale", "source_file": "docs/system-logic/rbac-unit-level-migration-prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The unscoped 'General Staff' role is deleted because every real staff member should belong to a School (as lecturer) or a Service department (as staff-level); unresolvable users are surfaced in a migration report rather than guessed."}, {"id": "docs_system_logic_rbac_unit_level_migration_prompt_role_generic_marker_compat", "label": "users.role generic level marker compatibility field", "file_type": "rationale", "source_file": "docs/system-logic/rbac-unit-level-migration-prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "role still needs a value for unit-scoped users so existing code reading users.role doesn't break everywhere at once; role stores the same string as function_level as a legacy/display-compat column while function_level is the new source of truth."}, {"id": "docs_system_logic_rbac_unit_level_migration_prompt_migration_script", "label": "migrate-unit-level-roles.js migration script", "file_type": "code", "source_file": "docs/system-logic/rbac-unit-level-migration-prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_system_logic_rbac_unit_level_migration_prompt_role_navigation_ts", "label": "role-navigation.ts re-keying", "file_type": "code", "source_file": "docs/system-logic/rbac-unit-level-migration-prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_system_logic_rbac_unit_level_migration_prompt_role_labels_js", "label": "role-labels.js unitRoleLabel helper", "file_type": "code", "source_file": "docs/system-logic/rbac-unit-level-migration-prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_system_logic_rbac_unit_level_migration_prompt_admin_routes_js", "label": "admin.routes.js projectUser() derivation", "file_type": "code", "source_file": "docs/system-logic/rbac-unit-level-migration-prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_system_logic_rbac_unit_level_migration_prompt_auth_routes_js", "label": "auth.routes.js login response derivation", "file_type": "code", "source_file": "docs/system-logic/rbac-unit-level-migration-prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_system_logic_rbac_unit_level_migration_prompt_unit_code_readonly_rationale", "label": "Unit Code auto-derived read-only field", "file_type": "rationale", "source_file": "docs/system-logic/rbac-unit-level-migration-prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unit Code is read-only and computed live from Unit Name on both client preview and server (never accepted as free client input) to guarantee client and server never disagree on the derivation."}, {"id": "docs_system_logic_rbac_unit_level_migration_prompt_school_warning_rationale", "label": "School unit-kind warning note", "file_type": "rationale", "source_file": "docs/system-logic/rbac-unit-level-migration-prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If 'school' appears anywhere in Unit Name or the derived Unit Code, a non-blocking inline warning appears since this will be treated as an academic School with HOS/HOD + Lecturer + Student levels, letting the admin correct Unit Kind if wrong without blocking save."}], "edges": [{"source": "docs_system_logic_rbac_unit_level_migration_prompt", "target": "docs_system_logic_rbac_unit_level_migration_prompt_unit_level_model", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/system-logic/rbac-unit-level-migration-prompt.md", "source_location": null, "weight": 1.0}, {"source": "docs_system_logic_rbac_unit_level_migration_prompt", "target": "docs_system_logic_rbac_unit_level_migration_prompt_applicant_role_deletion", "relation": "rationale_for", "confidence": "EX