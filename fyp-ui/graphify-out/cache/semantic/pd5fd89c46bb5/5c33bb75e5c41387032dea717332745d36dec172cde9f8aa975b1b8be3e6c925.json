{"nodes": [{"id": "docs_system_logic_system", "label": "APU EMS Source of Truth (system.md)", "file_type": "document", "source_file": "docs/system-logic/system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_system_logic_system_backend_owns_workflow_principle", "label": "Design Principle: backend owns the workflow", "file_type": "rationale", "source_file": "docs/system-logic/system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The frontend displays state, shows available actions, and sends actions but is never trusted to decide who can act; the backend determines the current step, validates authorization, decides the next step/responsible party, updates status, and records history."}, {"id": "docs_system_logic_system_snapshot_principle", "label": "Design Principle: manager-configured options are snapshotted", "file_type": "rationale", "source_file": "docs/system-logic/system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When an applicant picks a manager-configured dropdown option, the system copies the relevant fields into the request-specific table so that if a manager edits or deletes the option later, already-submitted requests keep their original snapshotted values and history doesn't change retroactively."}, {"id": "docs_system_logic_system_unit_level_roles", "label": "Unit + Level Roles (system.md section 2)", "file_type": "concept", "source_file": "docs/system-logic/system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_system_logic_system_config_table", "label": "config table (HIGH_PAX_THRESHOLD, CANCELLATION_DEADLINE_DAYS, MAX_EVENT_CATEGORIES)", "file_type": "concept", "source_file": "docs/system-logic/system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_system_logic_system_approval_workflow", "label": "Approval Workflow (system.md section 4)", "file_type": "concept", "source_file": "docs/system-logic/system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_system_logic_system_visibility_inbox_ongoing_history", "label": "Inbox / Ongoing / History visibility model", "file_type": "rationale", "source_file": "docs/system-logic/system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inbox/My Task shows only items where it's currently the user's turn to act; Ongoing shows items the user is involved with but not their turn (read-only); History shows completed items, with department staff only ever seeing approved ones since the decision is already made by the time it reaches them."}, {"id": "docs_system_logic_system_form_fields_proposal", "label": "6-step applicant proposal form", "file_type": "concept", "source_file": "docs/system-logic/system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_system_logic_system_database_tables", "label": "EMS Database (51 tables)", "file_type": "concept", "source_file": "docs/system-logic/system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_system_logic_system_users_table", "label": "users table", "file_type": "code", "source_file": "docs/system-logic/system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_system_logic_system_unit_table", "label": "unit table", "file_type": "code", "source_file": "docs/system-logic/system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_system_logic_syste