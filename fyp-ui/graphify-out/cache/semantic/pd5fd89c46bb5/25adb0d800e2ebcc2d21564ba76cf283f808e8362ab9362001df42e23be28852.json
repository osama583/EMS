{"nodes": [{"id": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design", "label": "RBAC Redesign: Users/Units/Roles/Page Visibility Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_data_driven_rationale", "label": "Fully data-driven RBAC rationale", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hardcoded branching in role-navigation.ts, workflow.service.js, and role-labels.js meant adding a department or changing reviewer logic required editing multiple files; the redesign makes Users, Units, Roles, and Page Visibility fully admin-managed from the UI with no code changes needed for routine org changes."}, {"id": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_role_catalog", "label": "9 seed role catalog (protected)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_fmb_job_merge_rationale", "label": "F&B job merge into head-of-department", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no separate 'fmb' or 'cafeteria-manager' role; the F&B reviewer job is performed entirely by whoever holds head-of-department on the food_beverage_services unit, correcting an earlier mistaken split of one real job."}, {"id": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_is_school_unit", "label": "isSchoolUnit(code) backend helper", "file_type": "code", "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_school_detection_rationale", "label": "School detection by substring match", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No unit_kind column exists; a unit is treated as a School purely by checking whether unit.code contains 'school', kept as an internal backend helper never exposed as an admin-facing field."}, {"id": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_protected_roles_rationale", "label": "Protected vs custom role distinction", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 9 seed roles are permanently protected (role_code, is_unit_scoped, unit-eligibility rule immutable, never deletable) so core workflow routing can't be broken by admin edits, while custom roles beyond these 9 remain fully editable/deletable."}, {"id": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_soft_delete_archive_rationale", "label": "Soft-delete with 7-day auto-purge", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Roles and Units use soft-delete to archived_at state (hidden, grants no permissions) restorable by admin, auto-purged after 7 days if not restored, giving a recovery window against accidental deletion."}, {"id": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_one_head_per_unit_rationale", "label": "One head per unit constraint", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A unit may have at most one head-of-school or head-of-department assignment at a time, hard blocked with a toast rather than silently replacing an existing head, to prevent ambiguous review authority."}, {"id": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_nav_builder", "label": "Page Visibility / Nav Builder", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_nav_page_table", "label": "nav_page table", "file_type": "code", "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_nav_page_roles_table", "label": "nav_page_roles table", "file_type": "code", "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_user_unit_roles_table", "label": "user_unit_roles table", "file_type": "code", "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_role_table", "label": "role table", "file_type": "code", "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_unit_table", "label": "unit table", "file_type": "code", "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_users_table", "label": "users table (identity fields only)", "file_type": "code", "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_role_eligibility_service", "label": "role-eligibility.service.js", "file_type": "code", "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_user_access_service", "label": "user-access.service.js", "file_type": "code", "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_nav_tree_service", "label": "nav-tree.service.js", "file_type": "code", "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_workflow_service_hashole_update", "label": "workflow.service.js hasRole update", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every function_level==='manager'/isManagerOfUnit check becomes hasRole(userId,'head-of-department',unitCode) || hasRole(userId,'head-of-school',unitCode); isHosHodOfUnit keeps its name for external callers but delegates to the new helper; FLAT_ROLE_FOR_REQUIREMENT.fmb stays as a routing token, not a user role."}, {"id": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_auth_models_ts", "label": "auth.models.ts AuthUser.roles redesign", "file_type": "code", "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_role_access_ts", "label": "role-access.ts module", "file_type": "code", "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_role_navigation_ts_replacement", "label": "role-navigation.ts navTreeFor replacement", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ROLE_NAVIGATION static map and unitNavigationFor() are deleted in favor of navigationFor(user) calling the backend's /nav-tree, so nav_page becomes the single source of truth for the sidebar instead of hardcoded TypeScript."}], "edges": [{"source": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design", "target": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_data_driven_rationale", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design", "target": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_role_catalog", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_role_catalog", "target": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_fmb_job_merge_rationale", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_fmb_job_merge_rationale", "target": "docs_superpowers_specs_2026_08_10_ems_schema_alignment_and_mock_backend_design_fmb_role_merge", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-redesign-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design", "target": "docs_superpowers_specs_2026_08_13_rbac_role_unit_redesign_design_is_school_unit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-13-rbac-role-unit-